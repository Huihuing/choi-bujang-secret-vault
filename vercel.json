{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/ai",
      "destination": "/api/war-room-summary?__package_route=ai"
    },
    {
      "source": "/api/threat-intel",
      "destination": "/api/war-room-summary?__package_route=threat-intel"
    }
  ]
}
