{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/public-config",
      "destination": "/api/war-room?__package_route=public-config"
    },
    {
      "source": "/api/war-room-summary",
      "destination": "/api/war-room?__package_route=war-room-summary"
    }
  ]
}
